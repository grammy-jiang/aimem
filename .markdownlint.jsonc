{
  // markdownlint configuration for aimem docs
  // Design and requirements documents — tables are inherently wide.
  "default": true,

  // MD013: line length — disabled for tables and code blocks; set generous
  //        limit for prose (headings and bare paragraphs rarely exceed 160).
  "MD013": {
    "line_length": 160,
    "heading_line_length": 160,
    "code_block_line_length": 160,
    "tables": false
  },

  // MD024: allow duplicate headings in different sections (e.g. "## Status")
  "MD024": {
    "siblings_only": true
  },

  // MD033: inline HTML — allow <br> and detail/summary blocks used in some docs
  "MD033": false,

  // MD041: first-line heading — some files start with a metadata block
  "MD041": false
}
